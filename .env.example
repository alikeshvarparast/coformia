# Copy to .env and fill in. Required for contact form: TURNSTILE_SECRET + (RESEND_API_KEY or SMTP_*).

TURNSTILE_SECRET=
MAIL_TO=info@coformia.com
MAIL_FROM=Coformia website <info@coformia.com>

# Option A — Resend (https://resend.com, verify coformia.com)
RESEND_API_KEY=

# Option B — SMTP (e.g. Gmail app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
